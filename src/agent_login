import random
import csv


# ============================================================
# Настройки генерации
# ============================================================

# Фиксированный seed нужен для воспроизводимости результата.
# При каждом запуске с теми же исходными данными
# сотрудники будут генерироваться одинаково.
random.seed(42)

# Количество синтетических сотрудников.
# Важно: должно совпадать с количеством агентов,
# используемых в генераторе call_segments.
EMPLOYEE_COUNT = 120

# Путь к итоговому CSV-файлу.
OUTPUT_FILE = (
    r"C:\Users\Александр\Documents\Экспорт из БД"
    r"\Моделирование данных\employees.csv"
)


# ============================================================
# Справочники для генерации ФИО
# ============================================================

LAST_NAMES = [
    "Иванов", "Петров", "Сидоров", "Смирнов", "Кузнецов",
    "Попов", "Васильев", "Соколов", "Михайлов", "Новиков",
    "Федоров", "Морозов", "Волков", "Алексеев", "Лебедев",
    "Семенов", "Егоров", "Павлов", "Козлов", "Степанов",
    "Николаев", "Орлов", "Андреев", "Макаров", "Никитин",
    "Захаров", "Зайцев", "Соловьев", "Борисов", "Яковлев",
    "Григорьев", "Романов", "Воробьев", "Сергеев", "Кузьмин",
    "Фролов", "Александров", "Дмитриев", "Королев", "Гусев"
]

MALE_NAMES = [
    "Александр", "Максим", "Дмитрий", "Иван", "Алексей",
    "Михаил", "Андрей", "Сергей", "Роман", "Евгений",
    "Владимир", "Николай", "Павел", "Артем", "Виктор"
]

FEMALE_NAMES = [
    "Анна", "Елена", "Мария", "Ольга", "Наталья",
    "Екатерина", "Ирина", "Татьяна", "Светлана", "Юлия",
    "Анастасия", "Дарья", "Виктория", "Ксения", "Александра"
]

MALE_PATRONYMICS = [
    "Александрович", "Максимович", "Дмитриевич", "Иванович",
    "Алексеевич", "Михайлович", "Андреевич", "Сергеевич",
    "Романович", "Евгеньевич", "Владимирович", "Николаевич",
    "Павлович", "Артемович", "Викторович"
]

FEMALE_PATRONYMICS = [
    "Александровна", "Максимовна", "Дмитриевна", "Ивановна",
    "Алексеевна", "Михайловна", "Андреевна", "Сергеевна",
    "Романовна", "Евгеньевна", "Владимировна", "Николаевна",
    "Павловна", "Артемовна", "Викторовна"
]


# ============================================================
# Генерация сотрудников
# ============================================================

def generate_employees(n=EMPLOYEE_COUNT):
    """
    Создаёт список синтетических сотрудников.

    employee_id:
        Синтетический идентификатор сотрудника.
        Формат совпадает с логинами операторов:
        0001, 0002, ..., 0120.

    employee_name:
        Синтетическое ФИО сотрудника.

    Повторение полного ФИО исключается.
    """

    employees = []
    used_names = set()

    while len(employees) < n:

        # Случайно выбираем пол сотрудника.
        if random.random() < 0.5:
            name = random.choice(MALE_NAMES)
            patronymic = random.choice(MALE_PATRONYMICS)
        else:
            name = random.choice(FEMALE_NAMES)
            patronymic = random.choice(FEMALE_PATRONYMICS)

        surname = random.choice(LAST_NAMES)

        full_name = f"{surname} {name} {patronymic}"

        # Не допускаем повторения полного ФИО.
        if full_name in used_names:
            continue

        used_names.add(full_name)

        employees.append({
            "employee_id": f"{len(employees) + 1:04d}",
            "employee_name": full_name
        })

    return employees


# ============================================================
# Создание CSV
# ============================================================

employees = generate_employees()

with open(
    OUTPUT_FILE,
    "w",
    newline="",
    encoding="utf-8-sig"
) as f:

    writer = csv.DictWriter(
        f,
        fieldnames=[
            "employee_id",
            "employee_name"
        ],
        delimiter=";"
    )

    # Заголовки CSV.
    writer.writeheader()

    # Данные сотрудников.
    writer.writerows(employees)


# ============================================================
# Контроль результата
# ============================================================

print(f"Создано сотрудников: {len(employees)}")
print(f"Файл: {OUTPUT_FILE}")
